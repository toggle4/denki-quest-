  "questions": [
    {
      "id": "E01-t01",
      "type": "template",
      "difficulty": 2,
      "prompt": "{V} V の電源に {R} Ω の抵抗 3 本を直列につないだ回路で、そのうち 1 本の両端をスイッチで短絡した。回路に流れる電流は何 A か。",
      "variables": {
        "V": {
          "min": 100,
          "max": 200,
          "step": 100
        },
        "R": {
          "min": 5,
          "max": 25,
          "step": 5
        }
      },
      "answerFormula": "V / (2 * R)",
      "answerType": "choice",
      "unitLabel": "A",
      "roundTo": 0,
      "explanation": "短絡された抵抗には電流が流れず、残り 2 本の直列 2R に V がかかる。I = {V} ÷ (2 × {R}) = {answer} A。",
      "tags": [
        "計算",
        "直並列",
        "短絡"
      ],
      "srsWeight": 1.2,
      "constraints": [
        "V % (2 * R) == 0"
      ],
      "distractors": [
        "V / (3 * R)",
        "V / R",
        "V / (6 * R)"
      ],
      "origin": "短絡 = short circuit。",
      "tip": "スイッチで抵抗を短絡する回路は、試験の「問 1」の定番。"
    },
    {
      "id": "E01-t02",
      "type": "template",
      "difficulty": 2,
      "prompt": "{R1} Ω と {R2} Ω の並列接続に {R3} Ω を直列につなぎ、{V} V を加えた。{R3} Ω の抵抗の消費電力は何 W か。整数で答えよ。",
      "variables": {
        "R1": {
          "min": 10,
          "max": 30,
          "step": 10
        },
        "R2": {
          "min": 30,
          "max": 60,
          "step": 30
        },
        "R3": {
          "min": 4,
          "max": 12,
          "step": 4
        },
        "V": {
          "min": 100,
          "max": 200,
          "step": 100
        }
      },
      "answerFormula": "pow(V / (R1 * R2 / (R1 + R2) + R3), 2) * R3",
      "answerType": "numeric",
      "unitLabel": "W",
      "roundTo": 0,
      "explanation": "並列部分 = {R1}×{R2}÷({R1}+{R2}) Ω。全体の抵抗にそれを足し、I = V ÷ 全抵抗。P = I² × {R3} = {answer} W。",
      "tags": [
        "計算",
        "直並列",
        "電力"
      ],
      "srsWeight": 1.2
    },
    {
      "id": "E01-t03",
      "type": "template",
      "difficulty": 2,
      "prompt": "同じ {R} Ω の抵抗 3 本を、2 本並列にしたものと残り 1 本を直列につないだ。合成抵抗は何 Ω か。",
      "variables": {
        "R": {
          "min": 4,
          "max": 40,
          "step": 4
        }
      },
      "answerFormula": "R * 1.5",
      "answerType": "choice",
      "unitLabel": "Ω",
      "roundTo": 1,
      "explanation": "並列 2 本 = {R}÷2、それに {R} を足して 1.5 × {R} = {answer} Ω。",
      "tags": [
        "計算",
        "直並列"
      ],
      "srsWeight": 1.2,
      "distractors": [
        "R * 3",
        "R / 3",
        "R * 2"
      ]
    },
    {
      "id": "E01-t04",
      "type": "template",
      "difficulty": 2,
      "prompt": "直径 1.6 mm・長さ {L1} m の銅線 A と、直径 3.2 mm・長さ {L2} m の銅線 B がある。A の抵抗は B の抵抗の何倍か。",
      "variables": {
        "L1": {
          "min": 10,
          "max": 100,
          "step": 10
        },
        "L2": {
          "min": 10,
          "max": 100,
          "step": 10
        }
      },
      "answerFormula": "(L1 / L2) * 4",
      "answerType": "choice",
      "unitLabel": "倍",
      "roundTo": 0,
      "explanation": "抵抗は長さに比例し、断面積（直径の 2 乗）に反比例。直径が半分なら抵抗は 4 倍。({L1}÷{L2}) × 4 = {answer} 倍。",
      "tags": [
        "計算",
        "抵抗率"
      ],
      "srsWeight": 1.2,
      "constraints": [
        "(4 * L1) % L2 == 0"
      ],
      "distractors": [
        "L1 / L2",
        "(L1 / L2) * 2",
        "(L1 / L2) * 8"
      ],
      "origin": "抵抗は長さに比例、断面積に反比例 = R ∝ L / A。",
      "tip": "直径 2 倍で断面積 4 倍。だから 2.0 mm と 1.6 mm の許容電流の差が大きい。"
    },
    {
      "id": "E01-t05",
      "type": "template",
      "difficulty": 2,
      "prompt": "直径 {D} mm・長さ {L} m の軟銅線と同じ抵抗値になる、長さが {n} 倍（{L} m の {n} 倍）の軟銅線の直径は何 mm か。",
      "variables": {
        "D": {
          "min": 1.6,
          "max": 2.0,
          "step": 0.4
        },
        "L": {
          "min": 5,
          "max": 20,
          "step": 5
        },
        "n": {
          "min": 4,
          "max": 9,
          "step": 5
        }
      },
      "answerFormula": "D * sqrt(n)",
      "answerType": "choice",
      "unitLabel": "mm",
      "roundTo": 1,
      "explanation": "R ∝ L ÷ D²。長さを {n} 倍にしたら D² も {n} 倍、つまり直径は √{n} 倍 = {answer} mm。",
      "tags": [
        "計算",
        "抵抗率"
      ],
      "srsWeight": 1.2,
      "distractors": [
        "D * n",
        "D * sqrt(n) / 2",
        "D / sqrt(n)"
      ]
    },
    {
      "id": "E01-q01",
      "type": "multipleChoice",
      "difficulty": 2,
      "prompt": "抵抗率 ρ [Ω·m]、直径 D [mm]、長さ L [m] の導線の抵抗 R [Ω] を表す式はどれか。",
      "choices": [
        "R = 4ρL ÷ (πD²) × 10⁶",
        "R = πD²L ÷ (4ρ) × 10⁶",
        "R = ρL ÷ (πD²) × 10³",
        "R = 4ρL ÷ D² × 10⁶"
      ],
      "answerIndex": 0,
      "explanation": "R = ρL/A。断面積 A = πD²/4 で、D が mm なので m² に直すために 10⁻⁶ を掛ける（= 分母に来るので ×10⁶）。",
      "tags": [
        "公式",
        "抵抗率"
      ],
      "srsWeight": 1.0,
      "origin": "ρ（ロー）= resistivity（抵抗率）。",
      "tip": "銅の抵抗率は約 1.7×10⁻⁸ Ω·m。アルミは約 1.6 倍で、同じ電流には太い線が要る。"
    },
    {
      "id": "E01-q02",
      "type": "multipleChoice",
      "difficulty": 2,
      "prompt": "軟銅線の抵抗についての記述で誤っているものはどれか。",
      "choices": [
        "抵抗は断面積の 2 乗に反比例する",
        "温度が上がると抵抗は大きくなる",
        "抵抗は長さに比例する",
        "銅はアルミニウムより抵抗率が小さい"
      ],
      "answerIndex": 0,
      "explanation": "抵抗は断面積に反比例する（2 乗ではない）。直径の 2 乗に反比例、と混同しやすい。",
      "tags": [
        "抵抗率"
      ],
      "srsWeight": 1.0
    },
    {
      "id": "E01-q03",
      "type": "multipleChoice",
      "difficulty": 2,
      "prompt": "抵抗 R、電圧 V、電流 I、電力 P の関係で、R を表す式として誤っているものはどれか。",
      "choices": [
        "R = P I ÷ V",
        "R = P ÷ I²",
        "R = V² ÷ P",
        "R = V ÷ I"
      ],
      "answerIndex": 0,
      "explanation": "P = I²R → R = P/I²。P = V²/R → R = V²/P。V = IR → R = V/I。PI/V は次元が合わない。",
      "tags": [
        "公式",
        "電力"
      ],
      "srsWeight": 1.0
    }
