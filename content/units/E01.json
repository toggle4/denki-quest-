        "V": {
          "min": 100,
          "max": 200,
          "step": 100
        },
        "R": {
          "min": 5,
          "max": 25,
          "step": 5
        }
      },
      "answerFormula": "V / (2 * R)",
      "answerType": "choice",
      "unitLabel": "A",
      "roundTo": 0,
      "explanation": "短絡された抵抗には電流が流れず、残り 2 本の直列 2R に V がかかる。I = {V} ÷ (2 × {R}) = {answer} A。",
      "tags": [
        "計算",
        "直並列",
        "短絡"
      ],
      "srsWeight": 1.2,
      "constraints": [
        "V % (2 * R) == 0"
      ],
      "distractors": [
        "V / (3 * R)",
        "V / R",
        "V / (6 * R)"
      ]
    },
    {
