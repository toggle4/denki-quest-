          "min": 10,
          "max": 20,
          "step": 5
        }
      },
      "answerFormula": "SQRT3 * I * R",
      "answerType": "choice",
      "unitLabel": "V",
      "roundTo": 0,
      "explanation": "相電圧 = I × R = {I} × {R} V。線間電圧 = √3 × 相電圧 = {answer} V。",
      "tags": [
